ttd.tagdef Copyright -background #ffffff -font {-family arial -weight bold -slant roman -size 12 -underline 0 -overstrike 0} -foreground #7e5c2e -justify left
ttd.tagdef Body -background white -font {-family arial -weight normal -slant roman -size 10 -underline 0 -overstrike 0} -foreground #000000 -justify left -lmargin1 4 -lmargin2 12
ttd.tagdef Body_Title -background white -font {-family arial -weight bold -slant roman -size 11 -underline 0 -overstrike 0} -foreground #000000 -justify left
